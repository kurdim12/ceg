{
  "name": "maranasi-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:dialogs": "./scripts/check-dialogs.sh",
    "check:geo": "./scripts/check-geo.sh",
    "check:migrations": "./scripts/check-migrations.sh",
    "check": "npm run typecheck && npm run test && npm run check:dialogs && npm run check:geo && npm run check:migrations",
    "migrate:remote": "wrangler d1 migrations apply maranasi-engine --remote",
    "deploy": "npm run migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "libphonenumber-js": "^1.13.8",
    "postal-mime": "^2.7.5",
    "tldts": "^7.4.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20250620.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.20.0"
  }
}
